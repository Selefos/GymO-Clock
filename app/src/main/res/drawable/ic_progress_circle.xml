<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="ring"
            android:thicknessRatio="50"
            android:useLevel="false">
            <solid android:color="#D32A4261" />
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270">
            <shape
                android:shape="ring"
                android:thicknessRatio="50"
                android:useLevel="true">
                <gradient
                    android:endColor="@color/custom_text_color"
                    android:startColor="@color/custom_text_color"
                    android:centerColor="#6E2F64"
                    android:type="linear" />
            </shape>
        </rotate>
    </item>
</layer-list>