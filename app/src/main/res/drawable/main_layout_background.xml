<?xml version="1.0" encoding="UTF-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="0dp" />
    <padding
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/layouts_stroke_color" />
    <gradient
        android:centerColor="@color/custom_primary_navy_blue"
        android:centerX="50%"
        android:centerY="100%"
        android:endColor="@color/black"
        android:gradientRadius="500dp"
        android:startColor="@color/custom_secondary_color"
        android:type="radial" />
</shape>