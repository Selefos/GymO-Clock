<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="200sp"
    android:background="@color/custom_transparent">

    <TextView
        android:id="@+id/exercise_name"
        android:layout_width="match_parent"
        android:layout_height="25sp"
        android:layout_gravity="center"
        android:hint="@string/exercise_name"
        android:importantForAutofill="no"
        android:textAlignment="center"
        android:textColor="@color/custom_text_color"
        android:textColorHint="@color/custom_text_color"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.007" />

    <ProgressBar
        android:id="@+id/progress_bar_work"
        style="@style/CircularDeterminateProgressBar"
        android:layout_width="120sp"
        android:layout_height="120sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_view"
        app:layout_constraintHorizontal_bias="0.022"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exercise_name"
        app:layout_constraintVertical_bias="0.19"
        tools:progress="60" />

    <TextView
        android:id="@+id/countdown_work"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/progress_bar_work"
        app:layout_constraintEnd_toEndOf="@+id/progress_bar_work"
        app:layout_constraintStart_toStartOf="@+id/progress_bar_work"
        app:layout_constraintTop_toTopOf="@+id/progress_bar_work" />


    <ImageButton
        android:id="@+id/exercise_settings_button"
        android:layout_width="50sp"
        android:layout_height="50sp"
        android:background="@drawable/ic_exercise_settings_button_borders"
        android:contentDescription="@string/exercise_settings_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/progress_bar_rest"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toEndOf="@+id/progress_bar_work"
        app:layout_constraintTop_toBottomOf="@+id/exercise_name" />

    <ProgressBar
        android:id="@+id/progress_bar_rest"
        style="@style/CircularDeterminateProgressBar"
        android:layout_width="120sp"
        android:layout_height="120sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.98"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exercise_name"
        app:layout_constraintVertical_bias="0.19"
        tools:progress="60" />

    <TextView
        android:id="@+id/countdown_rest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/progress_bar_rest"
        app:layout_constraintEnd_toEndOf="@+id/progress_bar_rest"
        app:layout_constraintStart_toStartOf="@+id/progress_bar_rest"
        app:layout_constraintTop_toTopOf="@+id/progress_bar_rest" />

    <ImageButton
        android:id="@+id/remove_view"
        android:layout_width="30sp"
        android:layout_height="30sp"
        android:layout_marginTop="20sp"
        android:background="@drawable/ic_remove_view"
        android:backgroundTint="@color/custom_text_color"
        android:contentDescription="@string/remove_view"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@+id/exercise_settings_button"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/progress_bar_work"
        app:layout_constraintTop_toBottomOf="@+id/exercise_name" />

    <ImageButton
        android:id="@+id/edit_view"
        android:layout_width="30sp"
        android:layout_height="30sp"
        android:layout_marginTop="20sp"
        android:background="@drawable/ic_edit_view"
        android:backgroundTint="@color/custom_text_color"
        android:contentDescription="@string/edit_view"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@+id/progress_bar_rest"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/exercise_settings_button"
        app:layout_constraintTop_toBottomOf="@+id/exercise_name" />

    <EditText
        android:id="@+id/weight_edit"
        android:layout_width="70sp"
        android:layout_height="wrap_content"
        android:layout_marginStart="76sp"
        android:autofillHints="Decimal Number"
        android:hint="@string/weight"
        android:inputType="numberDecimal"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar_work" />

    <EditText
        android:id="@+id/reps_edit"
        android:layout_width="70sp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="76sp"
        android:autofillHints="Integer Number"
        android:hint="@string/reps"
        android:inputType="number"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_bar_rest" />

</androidx.constraintlayout.widget.ConstraintLayout>