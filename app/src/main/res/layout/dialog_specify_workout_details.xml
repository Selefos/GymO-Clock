<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/delete_rename_workout_background">

    <LinearLayout
        android:id="@+id/layout_round_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screeningDB_button_next_set" />

    <ImageButton
        android:id="@+id/screeningDB_button_next_set"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/ic_next_button"
        android:contentDescription="@string/next_button"
        android:duplicateParentState="false"
        android:scaleType="fitCenter"
        android:textColor="@color/custom_text_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scroll_view_add_details"
        android:layout_width="match_parent"
        android:layout_height="412sp"
        android:layout_gravity="center_vertical"
        android:fillViewport="true"
        android:foregroundGravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_round_indicator" />

</androidx.constraintlayout.widget.ConstraintLayout>